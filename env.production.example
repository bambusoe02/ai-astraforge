# AstraForge Production Environment
# Copy this file to .env.production and fill in your values

# App Configuration
NODE_ENV=production
DEBUG=false

# API URLs (Production)
NEXT_PUBLIC_API_URL=https://your-api-domain.com
NEXT_PUBLIC_APP_URL=https://your-app-domain.com

# OpenAI API (required for AI agents)
OPENAI_API_KEY=sk-your-production-openai-key

# Clerk Authentication (Production keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your-production-clerk-key
CLERK_SECRET_KEY=sk_live_your-production-clerk-secret

# Stripe Payments (Production keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-production-stripe-key
STRIPE_SECRET_KEY=sk_live_your-production-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_your-production-webhook-secret

# Database (Production - Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host:5432/production_db

# Redis (Production - Redis Cloud, etc.)
REDIS_URL=redis://user:password@host:port

# GitHub App Integration (Production)
GITHUB_APP_ID=your-production-github-app-id
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nyour-production-github-private-key\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=your-production-github-webhook-secret

# Monitoring & Analytics (Production)
VERCEL_ANALYTICS_ID=your-production-analytics-id

# Security (Production)
NEXTAUTH_SECRET=your-production-nextauth-secret
NEXTAUTH_URL=https://your-app-domain.com

# AI Agent Configuration (Production optimized)
AI_MODEL=gpt-4
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=4000

# Performance & Caching
CACHE_TTL=3600
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900000
