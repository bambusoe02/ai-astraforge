# AstraForge Local Development Environment
# Copy this file to .env.local and fill in your values

# App Configuration
NODE_ENV=development
DEBUG=true

# API URLs (Local development)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# OpenAI API (required for AI agents)
OPENAI_API_KEY=your-openai-api-key-here

# Clerk Authentication (optional for auth features)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# Stripe Payments (optional for subscription features)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Database (Local PostgreSQL or use Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/astraforge

# Redis (Local or cloud instance)
REDIS_URL=redis://localhost:6379

# GitHub App Integration (optional)
GITHUB_APP_ID=your-github-app-id
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nyour-github-private-key\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Monitoring & Analytics (optional)
VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# Security
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3001

# AI Agent Configuration
AI_MODEL=gpt-4
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
