# AstraForge Environment Configuration
# Copy this file to .env and fill in your values

# AI Provider (REQUIRED for production - Anthropic Claude API)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Note: This is now REQUIRED for the production version. The app uses Claude Sonnet 4 for:
# - Chat with AI agents
# - Code generation across platforms
# - Real-time responses
# OPENAI_API_KEY=sk-your-openai-api-key-here (not currently used)

# Clerk Authentication (required for user auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# Stripe Payments (required for subscriptions)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Database (Neon PostgreSQL recommended)
DATABASE_URL=postgresql://username:password@host:5432/astraforge

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379

# GitHub App Integration (optional, for GitHub features)
GITHUB_APP_ID=your-github-app-id
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nyour-github-private-key\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Monitoring & Analytics
# Vercel Analytics works without env vars when deployed on Vercel.
# (Optional) Keep project-specific IDs/secrets here if you add them later.
# VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# Development
NODE_ENV=development
DEBUG=true

# Production Deployment
VERCEL_URL=https://ai-astraforge.vercel.app
# RAILWAY_STATIC_URL=https://your-api-host.example
