{
  "name": "@astraforge/api",
  "version": "1.0.0",
  "description": "FastAPI backend for AstraForge",
  "private": true,
  "scripts": {
    "dev": "python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "start": "python -m uvicorn main:app --host 0.0.0.0 --port 8000",
    "build": "echo 'No build step required'",
    "test": "pytest",
    "lint": "flake8 app/ --max-line-length=88",
    "typecheck": "mypy app/",
    "db:generate": "alembic revision --autogenerate -m 'auto migration'",
    "db:push": "alembic upgrade head"
  },
  "dependencies": {},
  "devDependencies": {}
}
